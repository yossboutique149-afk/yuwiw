{
  "name": "YumEra: Eternal Universe",
  "short_name": "YumEra",
  "description": "A social universe for people who love fictional worlds. Yumeshipping, F/O, yumesonas and original creations.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0a0510",
  "theme_color": "#1b0d24",
  "lang": "es",
  "categories": ["social", "lifestyle", "art"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Notification Center", "url": "/notifications", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Portrait Studio", "url": "/portrait", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Music Studio", "url": "/music", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
